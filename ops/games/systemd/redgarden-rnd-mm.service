# REDGARDEN on the WOTAN game box (rnd): R&D 10v10 matchmaker :7778 (WOTAN web, native --queue). Mirrors EMILY/gitops/specs/redgarden-*.pod (same ports, same args).
[Unit]
Description=REDGARDEN R&D 10v10 matchmaker :7778 (WOTAN web, native --queue)
After=network-online.target
Wants=network-online.target

[Service]
User=wotan-games
WorkingDirectory=/srv/games/redgarden/rnd
EnvironmentFile=/etc/games/redgarden.env
ExecStart=/srv/games/redgarden/bin/red_garden_matchmaker --listen-port 7778 --lobby-size 20 --server-bin /srv/games/redgarden/bin/red_garden_arena_server --first-game-port 7300 --game-port-range 20
Restart=always
RestartSec=5s
MemoryMax=1G
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/games/redgarden/rnd/var

[Install]
WantedBy=multi-user.target
