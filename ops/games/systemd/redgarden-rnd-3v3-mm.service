# REDGARDEN on the WOTAN game box (rnd3v3): R&D 3v3 matchmaker :7780. Mirrors EMILY/gitops/specs/redgarden-*.pod (same ports, same args).
[Unit]
Description=REDGARDEN R&D 3v3 matchmaker :7780
After=network-online.target
Wants=network-online.target

[Service]
User=wotan-games
WorkingDirectory=/srv/games/redgarden/rnd3v3
EnvironmentFile=/etc/games/redgarden.env
ExecStart=/srv/games/redgarden/bin/red_garden_matchmaker --listen-port 7780 --lobby-size 6 --server-bin /srv/games/redgarden/bin/red_garden_arena_server --first-game-port 7400 --game-port-range 10
Restart=always
RestartSec=5s
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/games/redgarden/rnd3v3/var

[Install]
WantedBy=multi-user.target
