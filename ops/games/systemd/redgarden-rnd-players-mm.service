# REDGARDEN on the WOTAN game box (rnd): R&D 1v1 players-only matchmaker :7779. Mirrors EMILY/gitops/specs/redgarden-*.pod (same ports, same args).
[Unit]
Description=REDGARDEN R&D 1v1 players-only matchmaker :7779
After=network-online.target
Wants=network-online.target

[Service]
User=wotan-games
WorkingDirectory=/srv/games/redgarden/rnd
EnvironmentFile=/etc/games/redgarden.env
ExecStart=/srv/games/redgarden/bin/red_garden_matchmaker --listen-port 7779 --lobby-size 2 --server-bin /srv/games/redgarden/bin/red_garden_arena_server --first-game-port 7600 --game-port-range 10
Restart=always
RestartSec=5s
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/games/redgarden/rnd/var

[Install]
WantedBy=multi-user.target
