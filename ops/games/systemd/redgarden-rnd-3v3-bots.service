# REDGARDEN on the WOTAN game box (rnd3v3): R&D 3v3 bot pool (5 bots -> :7780). Mirrors EMILY/gitops/specs/redgarden-*.pod (same ports, same args).
[Unit]
Description=REDGARDEN R&D 3v3 bot pool (5 bots -> :7780)
After=network-online.target
Wants=network-online.target
After=redgarden-rnd-3v3-mm.service
[Service]
User=wotan-games
WorkingDirectory=/srv/games/redgarden/rnd3v3
EnvironmentFile=/etc/games/redgarden.env
ExecStart=/srv/games/redgarden/rnd3v3/scripts/run_bot_pool.sh 5 7780
Restart=always
RestartSec=5s
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/games/redgarden/rnd3v3/var

[Install]
WantedBy=multi-user.target
