# shankpit-460 fill bots: 9 emily-bots kept queued so a human always lands in a 10-player FFA (founder 2026-08-04).
# The ticket secret comes from the env file, never a flag (ps would show it).
[Unit]
Description=shankpit-460 emily-bot fill pool (9 bots)
After=shankpit460-server.service
Wants=shankpit460-server.service

[Service]
User=wotan-games
WorkingDirectory=/srv/games/shankpit-460
EnvironmentFile=/etc/games/shankpit460.env
ExecStart=/srv/games/shankpit-460/bin/emily-bot -host 127.0.0.1 -port 4600 -bots 9 -duration 87600h
Restart=always
RestartSec=10s
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
