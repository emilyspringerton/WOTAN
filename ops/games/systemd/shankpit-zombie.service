# OG SHANKPIT on the WOTAN game box (zombie sandbox, UDP 6968). Mirrors EMILY/gitops/specs/shankpit.pod: built from SHANKPIT (make server,
# emily-bot), clients dial shankpit.okemily.com (DNS only).
[Unit]
Description=SHANKPIT zombie sandbox, UDP 6968
After=network-online.target 
Wants=network-online.target

[Service]
User=wotan-games
WorkingDirectory=/srv/games/shankpit
EnvironmentFile=/etc/games/shankpit.env
ExecStartPre=/bin/sh -c 'mkdir -p var/zombie && [ -f var/zombie/nextown_zombies.json ] || cp seed_zombie.json var/zombie/nextown_zombies.json'
ExecStart=/srv/games/shankpit/bin/shank_server --port 6968 --level var/zombie/nextown_zombies.json
Restart=always
RestartSec=5s
MemoryMax=512M
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/srv/games/shankpit/var

[Install]
WantedBy=multi-user.target
